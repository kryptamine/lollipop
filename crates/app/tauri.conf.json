{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lollipop",
  "version": "0.3.0",
  "identifier": "dev.lollipop.overlay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Lollipop",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3OEREQjkyQjZERjM5ODkKUldTSk9kKzJrdHVOUjZhMzk0SExDREYxTHBvc3c5R1VocU00UmtXTERaNUw2aDNoMjdTYWxPdFoK",
      "endpoints": [
        "https://github.com/kryptamine/lollipop/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}

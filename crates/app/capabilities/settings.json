{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "windows": ["settings"],
  "permissions": [
    "core:event:default",
    "allow-read-switches",
    "allow-set-widget",
    "allow-set-trigger",
    "allow-set-advice-language",
    "allow-set-launch-at-login",
    "allow-set-voiceover",
    "allow-read-voice-installed",
    "allow-read-openai-key",
    "allow-read-openai-key-failure",
    "allow-save-openai-key",
    "allow-remove-openai-key",
    "allow-open-openai-usage",
    "allow-set-recap-window",
    "allow-set-lessons"
  ]
}

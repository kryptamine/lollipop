{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lollipop",
  "version": "0.1.0",
  "identifier": "dev.lollipop.overlay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Lollipop",
        "width": 260,
        "height": 44,
        "x": 24,
        "y": 24,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}

[Unit]
Description=Restore the Lollipop database from its newest backup on a new host
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/lollipop/collector.sqlite3

[Service]
Type=oneshot
User=lollipop
EnvironmentFile=/etc/lollipop/backup.env
ExecStart=/usr/local/bin/lollipop-restore
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lollipop

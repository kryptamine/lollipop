[Unit]
Description=Collect ranked matches for the Lollipop Benchmark table
After=network-online.target lollipop-restore.service
Wants=network-online.target
# A failed restore must not leave a new host collecting into an empty database.
Requires=lollipop-restore.service
StartLimitIntervalSec=0

[Service]
User=lollipop
EnvironmentFile=/etc/lollipop/collector.env
ExecStart=/usr/local/bin/lollipop-collector collect --tier ${LOLLIPOP_TIER}
# The collector only exits on a failure it cannot retry, such as a rejected key.
Restart=always
RestartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lollipop

[Install]
WantedBy=multi-user.target

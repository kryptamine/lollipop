RCLONE_CONFIG_TABLES_TYPE=s3
RCLONE_CONFIG_TABLES_PROVIDER=Cloudflare
RCLONE_CONFIG_TABLES_ACCESS_KEY_ID={{ r2_tables_access_key_id }}
RCLONE_CONFIG_TABLES_SECRET_ACCESS_KEY={{ r2_tables_secret_access_key }}
RCLONE_CONFIG_TABLES_ENDPOINT={{ r2_endpoint }}
# The token cannot create buckets.
RCLONE_CONFIG_TABLES_NO_CHECK_BUCKET=true
# Without this, the HEAD after an upload gets a 501 from R2 and the upload reads as failed.
RCLONE_CONFIG_TABLES_NO_HEAD=true

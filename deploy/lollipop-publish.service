# Start it by hand for the manual run: systemctl start lollipop-publish.service
# /etc/lollipop/publish.env holds GH_TOKEN, with contents and issues write on the repo.
# /etc/lollipop/reworks.json is a copy of crates/collector/reworks.json: keep it current.
[Unit]
Description=Build and publish the Lollipop Benchmark table
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lollipop
EnvironmentFile=/etc/lollipop/publish.env
ExecStart=/usr/local/bin/lollipop-collector publish --reworks /etc/lollipop/reworks.json
